{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 26,
        "patch": 0
    },
    "include": [
    ],
    "configurePresets": [
        {
            "name": "x86-debug",
            "displayName": "x86 Debug",
            "description": "x86 Debug build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/x86-debug",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x86-release",
            "displayName": "x86 Release",
            "description": "x86 Release build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/x86-release",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "aarch64-debug",
            "displayName": "Aarch64 Debug",
            "description": "Aarch64 Debug build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/aarch64-debug",
            "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "aarch64-release",
            "displayName": "Aarch64 Release",
            "description": "Aarch64 Release build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/aarch64-release",
            "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x86-debug",
            "configurePreset": "x86-debug"
        },
        {
            "name": "x86-release",
            "configurePreset": "x86-release"
        },
        {
            "name": "aarch64-debug",
            "configurePreset": "aarch64-debug"
        },
        {
            "name": "aarch64-release",
            "configurePreset": "aarch64-release"
        }
    ]
}
